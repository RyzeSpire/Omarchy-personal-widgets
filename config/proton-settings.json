{
  "protocol": "wireguard",
  "killswitch": 0,
  "custom_dns": {
    "enabled": false,
    "ip_list": []
  },
  "ipv6": true,
  "anonymous_crash_reports": true,
  "features": {
    "netshield": 1,
    "moderate_nat": false,
    "vpn_accelerator": true,
    "port_forwarding": false,
    "split_tunneling": {
      "enabled": true,
      "mode": "include",
      "config_by_mode": {
        "exclude": {
          "mode": "exclude",
          "app_paths": [],
          "ip_ranges": []
        },
        "include": {
          "mode": "include",
          "app_paths": [
            "/usr/bin/chromium",
            "/usr/lib/chromium/chromium",
            "/usr/bin/discord"
          ],
          "ip_ranges": []
        }
      }
    }
  }
}